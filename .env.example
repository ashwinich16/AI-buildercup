# Google Cloud
GOOGLE_CLOUD_PROJECT=scout-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
SCOUT_AGENT_MODEL=gemini-2.5-flash

# Agent tuning (optional; these are the defaults). Pattern: SCOUT_<AGENT>_TEMPERATURE / _THINKING_BUDGET
SCOUT_ELICITATION_TEMPERATURE=0.5
SCOUT_ELICITATION_THINKING_BUDGET=512
SCOUT_ELICITATION_SAFETY_MAX_QUESTIONS=6
SCOUT_NARRATION_TEMPERATURE=0.7
SCOUT_NARRATION_THINKING_BUDGET=0
SCOUT_PRODUCT_EXPERT_TEMPERATURE=0.3
SCOUT_PRODUCT_EXPERT_THINKING_BUDGET=1024
SCOUT_COMPARISON_TEMPERATURE=0.2
SCOUT_COMPARISON_THINKING_BUDGET=2048
SCOUT_PREFERENCE_TEMPERATURE=0.2
SCOUT_PREFERENCE_THINKING_BUDGET=1024
# Any agent can use its own model, e.g. SCOUT_PRODUCT_EXPERT_MODEL=gemini-2.5-pro

# Web app
# demo = persona picker; firebase = Sign in with Google
SCOUT_AUTH_MODE=demo
# firebase mode only: Firebase console > Project settings > Your apps > Web app (public values)
SCOUT_FIREBASE_API_KEY=
# defaults to GOOGLE_CLOUD_PROJECT.firebaseapp.com
SCOUT_FIREBASE_AUTH_DOMAIN=
# any Cloud Text-to-Speech voice name
SCOUT_TTS_VOICE=en-US-Chirp3-HD-Aoede

# Vertex AI Search (set ENGINE_ID if you created a search app, else DATA_STORE_ID)
SCOUT_SEARCH_LOCATION=global
SCOUT_SEARCH_ENGINE_ID=
SCOUT_SEARCH_DATA_STORE_ID=

# Cloud SQL: pipeline jobs, and Scout's memory of each shopper (name, preferences, cart).
# Leave SCOUT_DB_INSTANCE empty to keep shopper memory in memory only (lost on restart).
SCOUT_DB_INSTANCE=scout-hackathon:asia-south2:scoutdb1
SCOUT_DB_NAME=scout_catalog
SCOUT_DB_USER=scout_app
SCOUT_DB_PASSWORD_SECRET=scoutdb1-password

# Catalog export (pipeline/export.py)
SCOUT_EXPORT_BUCKET=scout-hackathon-catalog
SCOUT_EXPORT_OBJECT=search/catalog.jsonl
